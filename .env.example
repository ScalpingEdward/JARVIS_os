# Copy to .env. Never commit real credentials.
ENVIRONMENT=production
APP_NAME=PHOENIX OS
JARVIS_BIND_ADDRESS=127.0.0.1
JARVIS_PORT=8000
PHOENIX_UI_BIND_ADDRESS=127.0.0.1
PHOENIX_UI_PORT=8080

POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://jarvis:replace-with-a-long-random-password@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# GitHub remote executor
GITHUB_TOKEN=

# Runner authentication; use a separate long random value.
SANDBOX_RUNNER_TOKEN=
RUNNER_POLL_SECONDS=5

# Optional secure remote access. Keep the API bound to 127.0.0.1 when using Tailscale Serve.
TAILSCALE_HOSTNAME=phoenix

# --- Telegram: trading setup approvals (backend/app/telegram_approvals) --
# The mobile approval buttons for setup_submission. Required for the
# webhook and /notify* endpoints; without these the routes exist but every
# call fails closed with a clear error. See backend/.env.example for the
# full, feature-by-feature explanation of every variable below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CALLBACK_SECRET=
TELEGRAM_AUTO_ADVANCE=false
TELEGRAM_LIVE_EXECUTION_CALLBACK_SECRET=
TELEGRAM_LIVE_EXECUTION_CHAT_ID=

# --- Telegram: Instagram post approval (backend/app/telegram_instagram) ---
# Approving a post from the phone. Its own signing secret, deliberately:
# a leak of either trading secret above must not be enough to forge a tap
# that approves something publicly visible under your own name. Uses
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID from above for delivery.
# Unset, /v1/telegram-instagram/* exists but every call fails closed with a
# clear error -- nothing is silently skipped.
# Note: a tap only sets the post to "approved". It never publishes, so you
# can still pick audio in the Instagram app and post Reels yourself.
TELEGRAM_INSTAGRAM_CALLBACK_SECRET=

# --- Telegram: receiving button taps (backend/app/telegram_inbound) -------
# Taps are fetched by long polling (getUpdates) -- no webhook, no public URL.
# Off by default so tests never consume the real bot queue.
TELEGRAM_POLLING_ENABLED=false

# --- Telegram: when the approval card arrives (app/telegram_instagram) ----
# 12:00 a feed post, 19:00 a Reel, in AURON_TIMEZONE. Off by default: it
# sends real cards to a real phone.
AURON_POSTING_SCHEDULE_ENABLED=false
AURON_TIMEZONE=Europe/Berlin

# A tap on "Freigeben" posts to Instagram straight away. Nothing posts
# without that tap. Off by default: the first real post is a one-way step.
AURON_AUTO_PUBLISH_ON_APPROVAL=false

# How long ffmpeg may take for one file. A 3.5-minute 4K HDR clip needs
# ~20 minutes on this laptop: the float tone map dominates, not the encode.
AURON_FFMPEG_TIMEOUT_SECONDS=2400

# --- n8n Drive-fetch webhook (n8n/auron-drive-file-fetch.json) ------------
# AURON holds no Drive credential; it asks n8n for a file's bytes (preview
# images for the approval card). Both sides read this secret.
AURON_DRIVE_FETCH_SECRET=

# --- Telegram: general mobile/voice assistant (backend/app/mobile, /voice) -
TELEGRAM_ALLOWED_USER_IDS=
ASSISTANT_NAME=
ASSISTANT_WAKE_NAME=
OWNER_SALUTATION=
VOICE_LANGUAGE=
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=
VOICE_WAKE_REPLY=

# --- Notification hub: email channel (real SMTP) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# --- Position monitor: background break-even/trailing-stop scanner -------
# Off by default -- see backend/.env.example for why.
POSITION_MONITOR_ENABLED=false
POSITION_MONITOR_INTERVAL_SECONDS=10

# --- Operator authentication (setup approval, Instagram approval) ------
AURON_OPERATOR_TOKEN=

# --- Instagram -------------------------------------------------------------
TAVILY_API_KEY=
N8N_INSTAGRAM_WEBHOOK_URL=http://n8n:5678/webhook/instagram-post

# --- TradingView sync (independent of the MT5/mt5_bridge trading path) ---
TRADINGVIEW_WEBHOOK_SECRET=

# --- Workflow scheduler (unrelated to position_monitor above) ------------
JARVIS_SCHEDULER_ENABLED=false
JARVIS_SCHEDULER_INTERVAL_SECONDS=60
JARVIS_WORKFLOW_STORE=
