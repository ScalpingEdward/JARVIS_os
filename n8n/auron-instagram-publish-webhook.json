    {
      "parameters": {
        "jsCode": "// Build the direct-fetchable image URL from the Drive file id.\n// This format (not the normal drive.google.com/file/d/.../view share\n// link) is what a plain HTTP GET -- which is what Instagram's own\n// fetcher does -- can actually read as raw image bytes.\nconst body = $('Webhook: /instagram-post1').first().json.body;\nconst fileId = body.media_items[0].post_ref;\n\nreturn {\n  json: {\n    image_url: `https://drive.google.com/uc?export=view&id=${fileId}`,\n    caption: body.caption,\n    request_id: body.request_id,\n  }\n};"
      },
