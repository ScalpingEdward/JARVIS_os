        "url": "=https://graph.instagram.com/v21.0/27471261452547997/media",
        "sendQuery": true,
        "options": {
          "timeout": 30000
        },
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify(Object.assign({ media_type: 'REELS', video_url: $json.video_url, caption: $json.caption, access_token: $env.AURON_IG_ACCESS_TOKEN }, ($json.thumb_offset === undefined || $json.thumb_offset === null) ? {} : { thumb_offset: $json.thumb_offset })) }}"
      },
