            }
          },
          "options": {}
        },
        "id": "35c7447e-21f1-41f9-bb70-7a2c83588959",
        "name": "Google Drive: Make File Viewable by Link1",
        "type": "n8n-nodes-base.googleDrive",
        "typeVersion": 3,
        "position": [
          704,
          -352
        ],
        "credentials": {
          "googleDriveOAuth2Api": {
            "id": "sVwp500LT1RTHHDT",
            "name": "Google Drive account"
          }
        },
        "notes": "Instagram fetches the image itself, so it must be publicly reachable at request time. 'anyone with the link, reader' is the minimum needed."
      },
      {
        "parameters": {
          "jsCode": "// Build the direct-fetchable image URL from the Drive file id.\n// This format (not the normal drive.google.com/file/d/.../view share\n// link) is what a plain HTTP GET -- which is what Instagram's own\n// fetcher does -- can actually read as raw image bytes.\nconst body = $('Webhook: /instagram-post1').first().json.body;\nconst fileId = body.media_items[0].media_ref;\n\nreturn {\n  json: {\n    image_url: `https://drive.google.com/uc?export=view&id=${fileId}`,\n    caption: body.caption,\n    request_id: body.request_id,\n  }\n};"
        },
        "id": "9630d5a7-f8fb-4531-b347-a13a55d5a4b8",
        "name": "Build Public Image URL1",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          944,
          -352
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://graph.instagram.com/v21.0/27471261452547997/media",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "image_url",
                "value": "={{$json.image_url}}"
              },
              {
                "name": "caption",
                "value": "={{$json.caption}}"
              },
              {
                "name": "access_token",
                "value": "={{ $env.AURON_IG_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "42b377a9-df52-4e3a-8f58-416fcd8a91c5",
        "name": "Instagram: Create Media Container1",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1184,
          -352
        ],
        "notes": "Token must be replaced before import. Long-lived Instagram User token from Business Login for Instagram (graph.instagram.com host, NOT graph.facebook.com)."
      },
      {
        "parameters": {
          "amount": 8
        },
        "id": "3799e30a-1c2b-4ae3-a197-5686d15b5778",
        "name": "Wait for Instagram to Process1",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          1424,
          -352
        ],
        "webhookId": "636fbef3-4371-4b91-80bd-feaeab8d05cc",
        "notes": "Fixed wait is a reasonable v1 for a single image. The correct version polls GET /{container-id}?fields=status_code until FINISHED."
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://graph.instagram.com/v21.0/27471261452547997/media_publish",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "creation_id",
                "value": "={{$('Instagram: Create Media Container1').item.json.id}}"
              },
              {
                "name": "access_token",
                "value": "={{ $env.AURON_IG_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "7c84661b-39e6-41c3-a618-6ce2ac059db2",
        "name": "Instagram: Publish Container1",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1664,
          -352
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { \"media_id\": $json.id } }}",
          "options": {}
        },
        "id": "dca83c4e-2bcf-4245-9037-66ee534893e4",
        "name": "Respond: media_id1",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.4,
        "position": [
          1904,
          -352
        ],
        "notes": "AURON's publisher.py reads exactly this field -- 'media_id'. Anything else, or a non-2xx status, is treated as a failed publish."
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { \"error\": \"post_format \" + $('Webhook: /instagram-post1').first().json.body.post_format + \" is not wired in this n8n workflow -- single_image and carousel are live.\" } }}",
          "options": {}
        },
        "id": "48ecf5c2-c3ec-454e-a7e6-8c282c4f5645",
        "name": "Unsupported format -> error response1",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.4,
        "position": [
          704,
          -80
        ],
        "notes": "A clear, honest failure rather than a silent no-op. AURON's publisher.py treats any non-2xx as a real failure and notifies Brano."
      }
