        "id": "0f495cb2-13a4-43dd-8183-d55b3c3b0906",
        "name": "Route: is single_image?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          464,
          -352
        ],
        "notes": "TRUE -> the proven single-image path. FALSE -> honest error response (reel/video still not wired)."
      },
      {
        "parameters": {
          "fieldToSplitOut": "body.media_items",
          "options": {}
        },
        "id": "9b3e1de2-4151-4bc0-89f7-fb2c1957c6bd",
        "name": "Split Out Media Items",
        "type": "n8n-nodes-base.splitOut",
        "typeVersion": 1,
        "position": [
          464,
          -592
        ],
        "notes": "Turns the single webhook item into one item per photo, so the Drive share and the per-image container calls run for every slide instead of only media_items[0]."
      },
      {
        "parameters": {
          "operation": "share",
          "fileId": {
            "__rl": true,
            "mode": "id",
            "value": "={{$json.media_ref}}"
          },
          "permissionsUi": {
            "permissionsValues": {
              "role": "reader",
              "type": "anyone"
            }
          },
          "options": {}
        },
        "id": "79c4252e-e3de-4ae9-910a-a73079ad22f3",
        "name": "Drive: Share Each Carousel File",
        "type": "n8n-nodes-base.googleDrive",
        "typeVersion": 3,
        "position": [
          704,
          -592
        ],
        "credentials": {
          "googleDriveOAuth2Api": {
            "id": "sVwp500LT1RTHHDT",
            "name": "Google Drive account"
          }
        },
        "notes": "Runs once per slide. If even one file stays private, Instagram's fetcher fails on that slide and the whole carousel container is rejected."
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://graph.instagram.com/v21.0/27471261452547997/media",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "image_url",
                "value": "=https://drive.google.com/uc?export=view&id={{ $('Split Out Media Items').item.json.media_ref }}"
              },
              {
                "name": "is_carousel_item",
                "value": "true"
              },
              {
                "name": "access_token",
                "value": "={{ $env.AURON_IG_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "5493e5aa-1be9-4708-bc4d-3d0048c244cd",
        "name": "IG: Create Carousel Item Container",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          944,
          -592
        ],
        "notes": "One container per slide, is_carousel_item=true. NO caption here -- the caption belongs on the parent CAROUSEL container only. Each response carries the container id we collect in the next step."
      },
      {
        "parameters": {
          "amount": 10
        },
        "id": "52ac7ae5-c69d-47b1-806f-dbd8a533c006",
        "name": "Wait for Item Containers",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          1184,
          -592
        ],
        "webhookId": "a1b2c3d4-0000-4000-8000-000000000001",
        "notes": "Gives Instagram time to fetch and process every slide before the parent container references them. Same fixed-wait caveat as the single-image path -- polling status_code per container is the correct upgrade."
      },
      {
        "parameters": {
          "jsCode": "// Collect one container id per slide and hand the parent step a single\n// comma-separated 'children' string, which is the shape the CAROUSEL\n// container endpoint expects.\nconst ids = $input.all()\n  .map(item => item.json.id)\n  .filter(id => id);\n\nconst body = $('Webhook: /instagram-post1').first().json.body;\n\nif (ids.length < 2) {\n  throw new Error(`Carousel needs at least 2 item containers, got ${ids.length}`);\n}\n\nreturn [{\n  json: {\n    children: ids.join(','),\n    child_count: ids.length,\n    caption: body.caption,\n    request_id: body.request_id,\n  }\n}];"
        },
        "id": "365d7139-a2d5-4a4b-a004-593062c065fd",
        "name": "Collect Container IDs",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1424,
          -592
        ],
        "notes": "Runs once over all items. Throws rather than silently posting a partial carousel if some slides failed -- AURON treats the non-2xx as a real failed publish."
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://graph.instagram.com/v21.0/27471261452547997/media",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "media_type",
                "value": "CAROUSEL"
              },
              {
                "name": "children",
                "value": "={{$json.children}}"
              },
              {
                "name": "caption",
                "value": "={{$json.caption}}"
              },
              {
                "name": "access_token",
                "value": "={{ $env.AURON_IG_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "5a15e6c9-acd9-4a7b-9c15-ed380b2c5f40",
        "name": "IG: Create Carousel Container",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1664,
          -592
        ],
        "notes": "The parent container. This is where the caption lives. Instagram allows 2-10 children."
      },
      {
        "parameters": {},
        "id": "27cc9f7e-3c8e-47f7-b15a-ba988aa6cab7",
        "name": "Wait for Carousel Container",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          1904,
          -592
        ],
        "webhookId": "a1b2c3d4-0000-4000-8000-000000000002"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://graph.instagram.com/v21.0/27471261452547997/media_publish",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "creation_id",
                "value": "={{$('IG: Create Carousel Container').item.json.id}}"
              },
              {
                "name": "access_token",
                "value": "={{ $env.AURON_IG_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "8f036827-c477-413f-a085-256f1d14f126",
        "name": "IG: Publish Carousel",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2144,
          -592
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { \"media_id\": $json.id } }}",
          "options": {}
        },
        "id": "df5b7546-d6fe-4621-a4ad-19b25c83fef3",
        "name": "Respond: carousel media_id",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.4,
        "position": [
          2384,
          -592
        ],
        "notes": "Same contract as the single-image response -- publisher.py only ever reads 'media_id'."
      },
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "instagram-post",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "c3e09aec-be33-47dc-a144-4aff4c69c088",
        "name": "Webhook: /instagram-post1",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          -464
        ],
        "webhookId": "32fec922-555a-4dfe-baf6-4ca88dd61187",
        "notes": "Must match N8N_INSTAGRAM_WEBHOOK_URL on the AURON side exactly. AURON calls this ONLY after a human has explicitly approved the candidate."
      },
      {
        "parameters": {
          "operation": "share",
          "fileId": {
            "__rl": true,
            "mode": "id",
            "value": "={{$json.body.media_items[0].media_ref}}"
          },
          "permissionsUi": {
            "permissionsValues": {
              "role": "reader",
