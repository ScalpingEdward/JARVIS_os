        ],
        "notes": "TRUE -> carousel branch (container per image + parent CAROUSEL container). FALSE -> falls through to the single_image check."
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
