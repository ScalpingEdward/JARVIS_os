            "timeout": 30000
          }
        },
        "id": "1fa0d60d-eeab-4320-a8f9-c6fbbe03bb91",
        "name": "AURON: Deliver Due Notifications v7",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
