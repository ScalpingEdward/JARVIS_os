        "name": "Schedule: Once Daily 09: v7",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          1872,
          -1216
        ]
      },
      {
        "parameters": {
          "resource": "fileFolder",
          "returnAll": true,
          "filter": {
            "folderId": {
              "__rl": true,
              "value": "11puO-Pd3xeCG-86mtP1tFXBmeTKAoj--",
