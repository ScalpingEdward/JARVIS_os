        "id": "0c9f6db7-2506-40c6-96d3-75275a479654",
        "name": "Filter: Is Image v7",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.2,
        "position": [
          2496,
          -1216
        ],
        "notes": "Nur Bilder. Die video/-Bedingung ist bewusst raus: das Datenmodell verlangt duration_seconds fuer Videos, der Payload-Node schickt null -> 200 mit failed:1, nichts wird gespeichert. Videos kommen zurueck, wenn der Reels-Pfad (media_type=REELS + Status-Polling + Dauer aus der Datei) steht."
      },
      {
        "parameters": {
          "operation": "download",
          "fileId": {
            "__rl": true,
            "mode": "id",
            "value": "={{$json.id}}"
          },
          "options": {}
        },
        "id": "4f246c47-1827-4815-bb5a-c7918ab24cb8",
        "name": "Google Drive: Download File v7",
        "type": "n8n-nodes-base.googleDrive",
        "typeVersion": 3,
        "position": [
          3104,
          -1216
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "credentials": {
          "googleDriveOAuth2Api": {
            "id": "sVwp500LT1RTHHDT",
            "name": "Google Drive account"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "// Base64-encode the downloaded binaries for AURON's vision endpoint.\n// AURON never holds a Drive credential itself -- n8n fetches bytes,\n// AURON only ever sees the encoded image it's handed.\n//\n// Runs once for ALL items of the current batch on purpose: $('Loop Over\n// Items').all() returns just this batch's items, a plain array read. The\n// per-item form ($('Loop Over Items v7').item) makes n8n trace paired items\n// back through every previous batch, which gets slower each round and\n// eventually times the task runner out on a large folder.\nconst driveItems = $('Loop Over Items v7').all();\n\nreturn $input.all().map((item, i) => {\n  const drive = driveItems[i].json;\n  const mediaType = drive.mimeType || 'image/jpeg';\n  const isVideo = mediaType.startsWith('video/');\n\n  return {\n    json: {\n      media_ref: drive.id,\n      media_type: isVideo ? 'video' : 'image',\n      image_base64: isVideo ? null : item.json.image_b64,\n      image_media_type: isVideo ? null : mediaType,\n      // A video's own frame extraction is a separate, optional step --\n      // see the README note below the workflow. Left null here on purpose\n      // rather than guessing a duration.\n      duration_seconds: null\n    }\n  };\n});"
        },
        "id": "4874be72-3b98-4ca6-9ec4-29f8b3c83585",
        "name": "Prepare AURON Payload v7",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          3520,
          -1216
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8000/v1/instagram/media-pool/analyze-and-ingest",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { \"items\": [ $json ] } }}",
          "options": {
            "timeout": 60000
          }
        },
        "id": "5d3858a1-2c77-45cd-bac5-060e15bceebe",
        "name": "AURON: Analyze + Ingest v7",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          3744,
          -1216
        ],
        "notes": "Replace 'auron-api' with your actual AURON api container name if different -- both containers must be on the shared 'jarvis_shared' Docker network (see docs/n8n-instagram-setup.md). Test with the real container hostname, not 'localhost'."
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8000/v1/instagram/curate",
          "options": {
            "timeout": 60000
          }
        },
        "id": "42b87884-0080-4e58-9ef4-2fdaf6912a5c",
        "name": "AURON: Run Curation v7",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          3984,
          -1216
        ],
        "executeOnce": true,
        "notes": "Runs once per schedule trigger, after every file in this batch has been ingested -- not once per file. n8n's default 'Run Once for All Items' setting on this node is correct; do not change it to 'Run Once for Each Item'."
      },
      {
