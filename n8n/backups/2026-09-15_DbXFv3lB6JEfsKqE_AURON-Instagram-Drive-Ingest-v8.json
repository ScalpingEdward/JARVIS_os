          "destinationKey": "image_b64",
          "options": {}
        },
        "type": "n8n-nodes-base.extractFromFile",
        "typeVersion": 1.1,
        "position": [
          3312,
          -1216
        ],
        "id": "d54ff3fa-7953-4676-888b-2724335c5b88",
        "name": "Extract from File v7"
      },
      {
        "parameters": {
          "url": "http://host.docker.internal:8000/v1/instagram/media-pool",
          "options": {
            "timeout": 60000
          }
        },
        "id": "0f8ab0df-1a3c-41a4-9105-36713db42c4e",
        "name": "AURON: Load Known Refs v7",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2064,
          -1216
        ],
        "notes": "Laedt alle bereits ingesteten Eintraege. Deren media_ref ist die Drive-File-ID; 'Filter: Not Yet Ingested' wirft die bekannten Dateien raus, BEVOR sie heruntergeladen und base64-kodiert werden."
      },
      {
        "parameters": {
          "jsCode": "// Dublettenpruefung VOR dem Download.\n// Die Backend-Pruefung in analyze_and_ingest spart nur die Vision-Analyse --\n// Drive-Download, Base64 und Payload liefen trotzdem jedes Mal komplett durch.\n// Hier fliegen bekannte Dateien raus, bevor sie irgendetwas kosten.\nconst pool = $('AURON: Load Known Refs v7').first().json;\nconst items = Array.isArray(pool) ? pool : (pool.items || []);\nconst known = new Set(items.map(i => i.media_ref).filter(Boolean));\n\nconst fresh = $input.all().filter(item => !known.has(item.json.id));\n\nconsole.log(`Pool kennt ${known.size} Dateien, ${$input.all().length} im Drive, ${fresh.length} neu.`);\n\nreturn fresh;"
        },
        "id": "417c1413-b14a-4e4a-9d63-b94f93561194",
        "name": "Filter: Not Yet Ingested v7",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2704,
          -1216
        ]
      },
      {
        "parameters": {},
        "id": "09371f5c-2968-4769-a5b4-14de037ddd95",
        "name": "Done: Alle Batches durch v8",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [
          4496,
          -1200
