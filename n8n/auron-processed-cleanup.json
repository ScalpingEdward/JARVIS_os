{
  "id": "AuronProcClean01",
  "name": "AURON - Processed Cleanup",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auron-processed-cleanup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000001",
      "name": "Webhook: /auron-processed-cleanup",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "7c2b9a14-58de-4f0b-9a33-6d1e2f4c8b90",
      "notes": "Moves superseded files in 'AURON fertig' to the Drive trash. Re-rendering wrote every file under the name it already had, and Drive keeps both instead of replacing -- so each pass doubled the folder."
    },
    {
      "parameters": {
        "jsCode": "// Same secret as the other AURON webhooks: this one deletes.\nconst expected = $env.AURON_DRIVE_FETCH_SECRET;\nconst given = (($input.first().json.headers) || {})['x-auron-secret'];\nif (!expected) {\n  throw new Error('AURON_DRIVE_FETCH_SECRET is not set in n8n -- refusing every request');\n}\nif (given !== expected) {\n  throw new Error('wrong or missing X-Auron-Secret');\n}\n// dry_run defaults to TRUE. Nothing is thrown away because a webhook was\n// called by accident; the report comes first, the deletion needs intent.\nconst body = $input.first().json.body || {};\nreturn [{ json: { dry_run: body.dry_run !== false } }];"
      },
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "Check secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "http://api:8000/v1/instagram/media-pool/current-processed-refs",
        "options": {
          "timeout": 60000
        }
      },
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "AURON: welche sind aktuell",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "executeOnce": true,
      "notes": "The ids AURON actually points at. Everything else in the folder is a leftover -- this is the only source that knows which is which."
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "1bp_LxsOhQVu_VXlMmnKBwK-HNlFSjBvX",
            "mode": "id"
          }
        },
        "options": {
          "fields": [
            "id",
            "name",
            "size"
          ]
        }
      },
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "Drive: was liegt in AURON fertig",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "sVwp500LT1RTHHDT",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Everything in the folder that AURON does not point at.\n//\n// Deliberately the difference of two real lists rather than \"keep the\n// newest per name\": a file AURON never recorded (an upload whose\n// bookkeeping call failed) is exactly as stale as an old render, and\n// guessing by timestamp would delete the wrong half of that pair.\nconst current = new Set($('AURON: welche sind aktuell').first().json.refs);\nconst dryRun = $('Check secret').first().json.dry_run;\nconst files = $input.all().map(i => i.json);\nconst stale = files.filter(f => !current.has(f.id));\nconst summary = {\n  dry_run: dryRun,\n  total_in_folder: files.length,\n  current_count: current.size,\n  stale_count: stale.length,\n  stale_mb: Math.round(stale.reduce((s, f) => s + Number(f.size || 0), 0) / 1048576),\n};\n// Always at least one item: with nothing stale the run used to end here\n// and the caller got an empty 200 -- indistinguishable from a failure.\nif (stale.length === 0) {\n  return [{ json: { ...summary, id: null, name: null } }];\n}\nreturn stale.map(f => ({ json: { ...summary, id: f.id, name: f.name, size: Number(f.size || 0) } }));"
      },
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Was ist veraltet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dry-run-check",
              "leftValue": "={{ $json.dry_run }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "has-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000006",
      "name": "Wirklich loeschen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "deleteFile",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "deletePermanently": false
        }
      },
      "id": "d1000000-0000-4000-8000-000000000007",
      "name": "Drive: in den Papierkorb",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1320,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "sVwp500LT1RTHHDT",
          "name": "Google Drive account"
        }
      },
      "notes": "Trash, not permanent: 30 days to change your mind, and the report above says exactly what went in."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { total_in_folder: $json.total_in_folder, in_use: $json.current_count, stale: $json.stale_count, stale_mb: $json.stale_mb, dry_run: $json.dry_run } }}",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000008",
      "name": "Respond: Bericht",
