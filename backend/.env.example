# JARVIS/PHOENIX OS backend -- environment configuration.
#
# This file is meant to be a complete, accurate list of what the backend
# actually reads from the environment, grouped by feature. Every value
# below was confirmed against the real code (a grep for every os.getenv/
# os.environ read across app/, cross-checked against which routes are
# actually reachable in the live FastAPI app) on 2026-09-07, not copied
# from an earlier version of this file or assumed from a module's name.
# A few modules read their secret's *env var name* from a per-connector
# config field rather than a hardcoded string (see automation_runtime's
# connector registration) -- those are not listed here since there is no
# single fixed name to document; see that module's own registration API.

JARVIS_APP_NAME=JARVIS OS
JARVIS_ENVIRONMENT=development
APP_ENV=development

# --- Anthropic / OpenAI ------------------------------------------------
# Two separate conventions exist in this codebase: the JARVIS_-prefixed
# ones below gate a specific settings object, while ANTHROPIC_API_KEY
# (no prefix) is read directly by the Instagram vision/caption pipeline,
# document_intelligence's AI analysis, and automation_runtime. Set both
# if you want every AI-backed feature working; JARVIS_ANTHROPIC_ENABLED
# alone does not turn on the unprefixed one.
JARVIS_ANTHROPIC_ENABLED=false
JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-5
JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
# Optional per-feature model overrides (Instagram captioning/vision,
# document_intelligence) -- fall back to a sensible default if unset.
AURON_CAPTION_MODEL=
AURON_DOCUMENT_MODEL=
AURON_VISION_MODEL=

# --- Telegram: trading setup approvals (telegram_approvals) ------------
# The mobile approval buttons for setup_submission. Required for the
# webhook and /notify* endpoints to do anything; without these, the
# routes exist but every call fails closed with a clear error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A dedicated signing secret for the inline-button callback tokens --
# deliberately NOT the bot token; see telegram_approvals/models.py for why.
TELEGRAM_CALLBACK_SECRET=
# Off by default. Sending "approved" also immediately runs
# advance_to_preflight (real risk sizing + a tracked position) rather
# than just recording the decision. See position_monitor's own note on
# why this stays opt-in.
TELEGRAM_AUTO_ADVANCE=false

# --- Telegram: general mobile/voice assistant (app/mobile, app/voice) --
# A separate integration from the approval bot above -- receives already-
# parsed Telegram updates at /v1/mobile/telegram/update and
# /v1/voice/telegram/voice. Neither endpoint registers its own Telegram
# webhook or holds a bot token itself; something external (an n8n
# Telegram Trigger node is the pattern used elsewhere in this build) is
# expected to forward Telegram traffic to these endpoints. Confirmed
# live and reachable, not independently verified further this session.
TELEGRAM_ALLOWED_USER_IDS=
ASSISTANT_NAME=
ASSISTANT_WAKE_NAME=
OWNER_SALUTATION=
VOICE_LANGUAGE=
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=
VOICE_WAKE_REPLY=

# --- Notification hub: email channel ------------------------------------
# Real SMTP (works with Gmail app passwords or any standard relay) --
# fails closed with a clear "missing X" error if any of these are unset,
# never silently pretends to have sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# --- Position monitor (background break-even/trailing-stop scanner) ----
# Off by default -- dozens of test files instantiate the FastAPI app
# directly and must stay unaffected unless a deployment opts in.
POSITION_MONITOR_ENABLED=false
# Matches bridge/mt5_pusher.py's own default push interval (5s); checking
# much faster than the source pushes would not surface fresher data.
POSITION_MONITOR_INTERVAL_SECONDS=10

# --- Operator authentication (setup approval, Instagram approval) ------
# Required for POST /v1/setup-submission/pending/{id}/decision and
# POST /v1/instagram/candidates/{id}/decision -- both fail closed (503)
# until this is set, and refuse (401) any request without a matching
# X-Auron-Operator-Token header. The Telegram approval path has its own,
# separate protection (a signed callback token + chat allowlist) and does
# not use this at all -- this only closes the *other* path into the same
# action: a direct API call. Generate a long random value.
AURON_OPERATOR_TOKEN=

# --- Instagram -----------------------------------------------------------
# Real web search for content research (curation/hashtag research).
TAVILY_API_KEY=
# Where the publisher hands off an approved post for actual Meta
# publishing -- AURON itself never holds Meta credentials. Has a working
# default pointing at a local n8n instance.
N8N_INSTAGRAM_WEBHOOK_URL=http://n8n:5678/webhook/instagram-post

# --- TradingView sync (independent of the MT5/mt5_bridge trading path) -
TRADINGVIEW_WEBHOOK_SECRET=

# --- Workflow scheduler (JARVIS_ prefix; unrelated to position_monitor) -
JARVIS_SCHEDULER_ENABLED=false
JARVIS_SCHEDULER_INTERVAL_SECONDS=60
JARVIS_WORKFLOW_STORE=
