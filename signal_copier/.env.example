# Copy to .env (setup.bat does that) and fill in. .env is your login -- never share it.

# https://my.telegram.org -> API development tools -> create an app
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your own bot from @BotFather (/newbot) -- it reports every trade of every profile to you
TELEGRAM_BOT_TOKEN=

# Your chat with that bot: write the bot any message, then run chat_id.bat
TELEGRAM_NOTIFY_CHAT_ID=

# Optional: AURON, which shows every profile's balance and profit per group.
# Empty = no reporting. On the same machine: http://localhost:8000
AURON_URL=
